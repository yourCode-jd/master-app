generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gym {
  id                      String                   @id @default(cuid())
  name                    String
  createdAt               DateTime                 @default(now())
  users                   User[]
  members                 Member[]
  audits                  AuditLog[]
  memberships             Membership[]
  notes                   Note[]
  preferences             AttentionPreference[]
  activities              MemberActivity[]
  goals                   Goal[]
  assessments             Assessment[]
  metrics                 ProgressMetric[]
  reviews                 ProgressReview[]
  milestones              Milestone[]
  attentionItems          AttentionItem[]
  intelligenceRuns        IntelligenceRun[]
  interventions           Intervention[]
  interventionAssignments InterventionAssignment[]
  notifications           Notification[]
  trainerInteractions     TrainerInteraction[]
  outcomes                Outcome[]
  memberJourneys          MemberJourney[]
  journeyTasks            JourneyTask[]
  feedbacks               MemberFeedback[]
  complaints              Complaint[]
  discomfortReports       DiscomfortReport[]
  floorZones              FloorZone[]
  occupancySnapshots      OccupancySnapshot[]
  equipment               Equipment[]
  equipmentIssues         EquipmentIssue[]
  maintenanceTasks        MaintenanceTask[]
  visitors                Visitor[]
  memberRequests          MemberRequest[]
  accessIssues            AccessIssue[]
  shiftHandovers          ShiftHandover[]
  communityGroups         CommunityGroup[]
  groupActivities         GroupActivity[]
  challenges              Challenge[]
  trainingProgress        TrainingProgress[]
  trainingEvents          TrainingEvent[]
}

model User {
  id                    String             @id @default(cuid())
  gymId                 String
  name                  String
  email                 String             @unique
  role                  String
  active                Boolean            @default(true)
  passwordHash          String
  createdAt             DateTime           @default(now())
  gym                   Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  audits                AuditLog[]         @relation("AuditActor")
  memberProfile         Member?            @relation("MemberAccount")
  trainedMembers        Member[]           @relation("TrainerMembers")
  authoredNotes         Note[]             @relation("NoteAuthor")
  activities            MemberActivity[]   @relation("ActivityActor")
  assessments           Assessment[]       @relation("AssessmentTrainer")
  progressReviews       ProgressReview[]   @relation("ReviewTrainer")
  assignedInterventions Intervention[]     @relation("InterventionAssignee")
  createdInterventions  Intervention[]     @relation("InterventionCreator")
  trainingProgress      TrainingProgress[]
  trainingEvents        TrainingEvent[]

  trainerInteractions  TrainerInteraction[] @relation("InteractionTrainer")
  evaluatedOutcomes    Outcome[]            @relation("OutcomeEvaluator")
  notifications        Notification[]       @relation("NotificationRecipient")
  assignedJourneys     MemberJourney[]      @relation("JourneyTrainer")
  assignedJourneyTasks JourneyTask[]        @relation("JourneyTaskAssignee")

  @@index([gymId, role])
}

model Member {
  id                      String                   @id @default(cuid())
  gymId                   String
  fullName                String
  email                   String
  phone                   String
  membershipStatus        String
  memberState             String
  attentionLevel          String
  joinDate                DateTime
  membershipEnd           DateTime
  assignedTrainer         String?
  trainerId               String?
  userId                  String?
  goal                    String
  lastVisit               DateTime?
  createdAt               DateTime                 @default(now())
  gym                     Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  visits                  Visit[]
  trainer                 User?                    @relation("TrainerMembers", fields: [trainerId], references: [id], onDelete: SetNull)
  user                    User?                    @relation("MemberAccount", fields: [userId], references: [id], onDelete: SetNull)
  memberships             Membership[]
  notes                   Note[]
  attentionPreference     AttentionPreference?
  activities              MemberActivity[]
  goals                   Goal[]
  assessments             Assessment[]
  metrics                 ProgressMetric[]
  reviews                 ProgressReview[]
  milestones              Milestone[]
  stateHistory            MemberStateHistory[]
  attentionItems          AttentionItem[]
  interventions           Intervention[]
  trainerInteractions     TrainerInteraction[]
  outcomes                Outcome[]
  journeys                MemberJourney[]
  journeyTasks            JourneyTask[]
  feedbacks               MemberFeedback[]
  complaints              Complaint[]
  discomfortReports       DiscomfortReport[]
  memberRequests          MemberRequest[]
  accessIssues            AccessIssue[]
  groupMemberships        GroupMembership[]
  groupParticipations     GroupParticipation[]
  challengeParticipations ChallengeParticipation[]

  @@unique([gymId, email])
  @@unique([userId])
  @@index([gymId, memberState])
  @@index([gymId, membershipStatus])
  @@index([gymId, trainerId])
}

model Visit {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  visitedAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, visitedAt])
  @@index([memberId, visitedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  gymId      String
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     String?
  after      String?
  createdAt  DateTime @default(now())
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  planName  String
  amount    Int
  status    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, status])
  @@index([memberId, endDate])
}

model Note {
  id         String   @id @default(cuid())
  gymId      String
  memberId   String
  authorId   String
  body       String
  visibility String   @default("STAFF")
  createdAt  DateTime @default(now())
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author     User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

model AttentionPreference {
  id             String   @id @default(cuid())
  gymId          String
  memberId       String   @unique
  level          String   @default("OCCASIONAL_CHECK_IN")
  contactMethod  String   @default("WHATSAPP")
  noInterruption Boolean  @default(false)
  trainerGender  String?
  updatedAt      DateTime @updatedAt
  gym            Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, level])
}

model MemberActivity {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  actorId   String?
  type      String
  message   String
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
}

model Goal {
  id            String    @id @default(cuid())
  gymId         String
  memberId      String
  type          String
  title         String
  description   String?
  startingValue Decimal?  @db.Decimal(12, 3)
  targetValue   Decimal?  @db.Decimal(12, 3)
  unit          String?
  startDate     DateTime
  targetDate    DateTime?
  status        String    @default("ACTIVE")
  isPrimary     Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  gym           Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([gymId, type])
}

model Assessment {
  id           String   @id @default(cuid())
  gymId        String
  memberId     String
  trainerId    String?
  assessedAt   DateTime
  weight       Decimal? @db.Decimal(12, 3)
  bodyFat      Decimal? @db.Decimal(5, 2)
  measurements String?
  strength     String?
  endurance    String?
  mobility     String?
  notes        String?
  photos       String?
  createdAt    DateTime @default(now())
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer      User?    @relation("AssessmentTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([memberId, assessedAt])
}

model ProgressMetric {
  id         String   @id @default(cuid())
  gymId      String
  memberId   String
  type       String
  value      Decimal  @db.Decimal(12, 3)
  unit       String
  recordedAt DateTime
  source     String
  notes      String?
  createdAt  DateTime @default(now())
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type, recordedAt, source])
  @@index([memberId, type, recordedAt])
}

model ProgressReview {
  id             String    @id @default(cuid())
  gymId          String
  memberId       String
  trainerId      String?
  reviewedAt     DateTime
  attendance     String?
  adherence      String?
  improvements   String?
  problems       String?
  planChanges    String?
  nextReviewDate DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  gym            Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer        User?     @relation("ReviewTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([memberId, reviewedAt])
}

model Milestone {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  type        String
  title       String
  description String?
  achievedAt  DateTime
  isAutomatic Boolean  @default(false)
  createdAt   DateTime @default(now())
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type, title])
  @@index([memberId, achievedAt])
}

model MemberStateHistory {
  id            String   @id @default(cuid())
  gymId         String
  memberId      String
  previousState String?
  state         String
  reason        String
  source        String
  calculatedAt  DateTime @default(now())
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, calculatedAt])
}

model AttentionItem {
  id                String    @id @default(cuid())
  gymId             String
  memberId          String
  ruleId            String
  title             String
  reason            String
  priority          String
  recommendedAction String
  assignedRole      String
  assignedUserId    String?
  status            String    @default("OPEN")
  dueAt             DateTime
  resolution        String?
  resolvedAt        DateTime?
  deduplicationKey  String    @unique
  relatedState      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  gym               Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member            Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  interventions Intervention[]

  @@index([gymId, status, priority])
}

model Intervention {
  id                String                   @id @default(cuid())
  gymId             String
  memberId          String
  attentionItemId   String?
  type              String
  reason            String
  recommendedAction String
  assignedToId      String?
  createdByUserId   String?
  title             String                   @default("Member intervention")
  priority          String                   @default("MEDIUM")
  assignedAt        DateTime?
  startedAt         DateTime?
  resolutionSummary String?
  deduplicationKey  String?                  @unique
  assignedRole      String
  status            String                   @default("OPEN")
  dueAt             DateTime
  actionTaken       String?
  memberResponse    String?
  followUpAt        DateTime?
  completedAt       DateTime?
  outcomeStatus     String                   @default("PENDING")
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  gym               Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member            Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attentionItem     AttentionItem?           @relation(fields: [attentionItemId], references: [id], onDelete: SetNull)
  assignedTo        User?                    @relation("InterventionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("InterventionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignments       InterventionAssignment[]
  interactions      TrainerInteraction[]
  outcome           Outcome?

  @@index([gymId, status, dueAt])
  @@index([memberId, createdAt])
  @@index([assignedToId, status, dueAt])
  @@index([gymId, priority, status])
}

model InterventionAssignment {
  id                 String       @id @default(cuid())
  gymId              String
  interventionId     String
  previousAssigneeId String?
  newAssigneeId      String?
  changedByUserId    String
  reason             String?
  createdAt          DateTime     @default(now())
  gym                Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  intervention       Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId, createdAt])
}

model TrainerInteraction {
  id             String        @id @default(cuid())
  gymId          String
  memberId       String
  trainerId      String
  interventionId String?
  type           String
  notes          String?
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  gym            Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer        User          @relation("InteractionTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([memberId, occurredAt])
  @@index([trainerId, occurredAt])
}

model IntelligenceRun {
  id               String   @id @default(cuid())
  gymId            String
  membersEvaluated Int
  rulesTriggered   Int
  newItems         Int
  resolvedItems    Int
  createdAt        DateTime @default(now())
  gym              Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model Outcome {
  id                    String       @id @default(cuid())
  gymId                 String
  memberId              String
  interventionId        String       @unique
  outcomeStatus         String
  evaluationDate        DateTime     @default(now())
  evaluationWindowStart DateTime
  evaluationWindowEnd   DateTime
  beforeSnapshot        String
  afterSnapshot         String
  primaryMetric         String
  beforeValue           Decimal?     @db.Decimal(12, 3)
  afterValue            Decimal?     @db.Decimal(12, 3)
  changeValue           Decimal?     @db.Decimal(12, 3)
  changePercent         Decimal?     @db.Decimal(8, 2)
  evaluatorUserId       String
  notes                 String?
  nextAction            String?
  businessImpactType    String?
  businessImpactValue   Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  gym                   Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member                Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  intervention          Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  evaluator             User         @relation("OutcomeEvaluator", fields: [evaluatorUserId], references: [id], onDelete: Cascade)

  @@index([gymId, outcomeStatus, evaluationDate])
  @@index([memberId, evaluationDate])
  @@index([evaluatorUserId, evaluationDate])
}

model Notification {
  id         String    @id @default(cuid())
  gymId      String
  userId     String?
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  gym        Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user       User?     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([userId, readAt])
}

model MemberJourney {
  id                String        @id @default(cuid())
  gymId             String
  memberId          String
  journeyTemplateId String?
  startDate         DateTime
  currentStage      String        @default("DAY_0")
  status            String        @default("ACTIVE")
  assignedTrainerId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?
  gym               Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member            Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedTrainer   User?         @relation("JourneyTrainer", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  tasks             JourneyTask[]

  @@index([gymId, status, currentStage])
  @@index([memberId, status])
}

model JourneyTask {
  id             String        @id @default(cuid())
  gymId          String
  journeyId      String
  memberId       String
  taskType       String
  title          String
  description    String?
  stage          String
  assignedRole   String
  assignedUserId String?
  dueDate        DateTime
  completedAt    DateTime?
  status         String        @default("OPEN")
  notes          String?
  required       Boolean       @default(true)
  escalationRule String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journey        MemberJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym            Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  assignedUser   User?         @relation("JourneyTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([journeyId, status, dueDate])
  @@index([memberId, dueDate])
  @@index([assignedUserId, status, dueDate])
}

model MemberFeedback {
  id                 String    @id @default(cuid())
  gymId              String
  memberId           String
  feedbackType       String
  rating             Int
  sentiment          String
  primaryReason      String?
  secondaryReasons   String?
  freeText           String?
  relatedTrainerId   String?
  relatedEquipmentId String?
  relatedZoneId      String?
  relatedVisitId     String?
  requestReason      String?
  confidential       Boolean   @default(false)
  status             String    @default("NEW")
  reviewedByUserId   String?
  reviewedAt         DateTime?
  resolutionNotes    String?
  createdAt          DateTime  @default(now())
  gym                Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, sentiment, createdAt])
  @@index([memberId, createdAt])
}

model Complaint {
  id                 String    @id @default(cuid())
  gymId              String
  memberId           String
  feedbackId         String?
  category           String
  severity           String
  description        String
  relatedTrainerId   String?
  relatedEquipmentId String?
  relatedZoneId      String?
  assignedToUserId   String?
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  resolution         String?
  followUpRequired   Boolean   @default(false)
  followUpDate       DateTime?
  gym                Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, status, severity])
  @@index([memberId, createdAt])
}

model DiscomfortReport {
  id                    String    @id @default(cuid())
  gymId                 String
  memberId              String
  reportedBy            String
  bodyArea              String
  description           String
  severity              String
  dateReported          DateTime  @default(now())
  triggeringExercise    String?
  temporaryModification String?
  trainerNote           String?
  status                String    @default("ACTIVE")
  followUpDate          DateTime?
  resolvedAt            DateTime?
  gym                   Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member                Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, status, followUpDate])
  @@index([memberId, dateReported])
}

model FloorZone {
  id               String              @id @default(cuid())
  gymId            String
  name             String
  description      String?
  zoneType         String
  status           String              @default("OPEN")
  capacity         Int
  currentOccupancy Int                 @default(0)
  busyState        String              @default("QUIET")
  updatedAt        DateTime            @updatedAt
  createdAt        DateTime            @default(now())
  sortOrder        Int                 @default(0)
  gym              Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment        Equipment[]
  snapshots        OccupancySnapshot[]

  @@unique([gymId, name])
  @@index([gymId, status, busyState])
}

model OccupancySnapshot {
  id               String    @id @default(cuid())
  gymId            String
  zoneId           String
  timestamp        DateTime  @default(now())
  occupancyCount   Int
  capacity         Int
  occupancyPercent Int
  state            String
  gym              Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  zone             FloorZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, timestamp])
}

model Equipment {
  id                  String            @id @default(cuid())
  gymId               String
  zoneId              String
  name                String
  equipmentType       String
  brand               String?
  model               String?
  assetCode           String
  purchaseDate        DateTime?
  status              String            @default("AVAILABLE")
  condition           String            @default("GOOD")
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  gym                 Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  zone                FloorZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  issues              EquipmentIssue[]
  maintenanceTasks    MaintenanceTask[]

  @@unique([gymId, assetCode])
  @@index([gymId, status, condition])
  @@index([zoneId, status])
}

model EquipmentIssue {
  id               String    @id @default(cuid())
  gymId            String
  equipmentId      String
  reportedByUserId String?
  issueType        String
  severity         String
  description      String
  status           String    @default("REPORTED")
  reportedAt       DateTime  @default(now())
  acknowledgedAt   DateTime?
  assignedToUserId String?
  resolvedAt       DateTime?
  resolutionNotes  String?
  gym              Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([gymId, status, severity])
  @@index([equipmentId, reportedAt])
}

model MaintenanceTask {
  id              String    @id @default(cuid())
  gymId           String
  equipmentId     String
  maintenanceType String
  scheduledDate   DateTime
  completedDate   DateTime?
  completedBy     String?
  notes           String?
  status          String    @default("SCHEDULED")
  createdAt       DateTime  @default(now())
  gym             Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([gymId, status, scheduledDate])
}

model Visitor {
  id                String    @id @default(cuid())
  gymId             String
  name              String
  phone             String?
  email             String?
  visitType         String
  expectedAt        DateTime
  arrivedAt         DateTime?
  completedAt       DateTime?
  assignedStaffId   String?
  assignedTrainerId String?
  source            String?
  notes             String?
  status            String    @default("EXPECTED")
  createdAt         DateTime  @default(now())
  gym               Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, status, expectedAt])
}

model MemberRequest {
  id           String    @id @default(cuid())
  gymId        String
  memberId     String
  category     String
  description  String
  priority     String    @default("MEDIUM")
  assignedToId String?
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  dueAt        DateTime?
  resolution   String?
  gym          Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, status, priority])
  @@index([memberId, createdAt])
}

model AccessIssue {
  id           String    @id @default(cuid())
  gymId        String
  memberId     String
  problem      String
  assignedToId String?
  resolution   String?
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  gym          Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, status, createdAt])
}

model ShiftHandover {
  id             String    @id @default(cuid())
  gymId          String
  createdBy      String
  shiftDate      DateTime
  shiftType      String
  note           String
  priority       String    @default("MEDIUM")
  createdAt      DateTime  @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  gym            Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, acknowledgedAt, shiftDate])
}

model CommunityGroup {
  id              String            @id @default(cuid())
  gymId           String
  name            String
  description     String?
  groupType       String
  visibility      String            @default("OPEN")
  status          String            @default("ACTIVE")
  startDate       DateTime?
  endDate         DateTime?
  capacity        Int?
  trainerId       String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  gym             Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships     GroupMembership[]
  activities      GroupActivity[]
  updates         GroupUpdate[]

  @@unique([gymId, name])
  @@index([gymId, status, groupType])
}

model GroupMembership {
  id               String         @id @default(cuid())
  groupId          String
  memberId         String
  joinedAt         DateTime       @default(now())
  status           String         @default("ACTIVE")
  assignedByUserId String?
  notes            String?
  group            CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([memberId, status])
}

model GroupActivity {
  id            String               @id @default(cuid())
  gymId         String
  groupId       String
  title         String
  scheduledAt   DateTime
  location      String?
  capacity      Int?
  trainerId     String?
  status        String               @default("UPCOMING")
  group         CommunityGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  gym           Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  participation GroupParticipation[]

  @@index([groupId, scheduledAt])
}

model GroupParticipation {
  id              String        @id @default(cuid())
  groupActivityId String
  memberId        String
  status          String        @default("REGISTERED")
  checkedInAt     DateTime?
  notes           String?
  activity        GroupActivity @relation(fields: [groupActivityId], references: [id], onDelete: Cascade)
  member          Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupActivityId, memberId])
}

model Challenge {
  id            String                   @id @default(cuid())
  gymId         String
  groupId       String?
  title         String
  description   String?
  challengeType String
  targetValue   Int
  unit          String
  startDate     DateTime
  endDate       DateTime
  status        String                   @default("ACTIVE")
  createdBy     String
  createdAt     DateTime                 @default(now())
  gym           Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  participation ChallengeParticipation[]

  @@index([gymId, status, endDate])
}

model ChallengeParticipation {
  id              String    @id @default(cuid())
  challengeId     String
  memberId        String
  progressValue   Int       @default(0)
  progressPercent Int       @default(0)
  completed       Boolean   @default(false)
  completionDate  DateTime?
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([challengeId, memberId])
}

model GroupUpdate {
  id        String         @id @default(cuid())
  groupId   String
  title     String
  message   String
  createdBy String
  createdAt DateTime       @default(now())
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model TrainingProgress {
  id             String    @id @default(cuid())
  gymId          String
  userId         String
  scenarioId     String
  role           String
  status         String    @default("ACTIVE")
  stepIndex      Int       @default(0)
  completedSteps Int       @default(0)
  skippedSteps   Int       @default(0)
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  gym            Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@index([gymId, status])
}

model TrainingEvent {
  id         String   @id @default(cuid())
  gymId      String
  userId     String
  scenarioId String
  eventType  String
  stepIndex  Int
  createdAt  DateTime @default(now())
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scenarioId, createdAt])
  @@index([gymId, createdAt])
}
